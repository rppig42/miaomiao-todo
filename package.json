{
  "name": "todo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run native && GOFLAGS=-buildvcs=false go tool mygo dev",
    "native": "sh scripts/build-native.sh",
    "signed": "zsh scripts/build-signed.sh",
    "generate": "GOFLAGS=-buildvcs=false go tool mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/core/*.test.ts",
    "build:debug": "GOFLAGS=-buildvcs=false go tool mygo build -debug -skip-dmg -skip-notarize -platform darwin/arm64 -o build/debug",
    "test:ui": "node scripts/wk-check.mjs",
    "test:lights": "node scripts/lights-check.mjs",
    "test:keys": "node scripts/keys-check.mjs",
    "test:sync": "node scripts/sync-check.mjs",
    "test:go": "GOFLAGS=-buildvcs=false go test ./...",
    "test:ios": "node scripts/ios-check.mjs",
    "ios": "zsh scripts/ios.sh",
    "release": "zsh scripts/release.sh"
  },
  "dependencies": {
    "mygo-runtime": "0.7.4",
    "preact": "^10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7",
    "vite": "^8"
  }
}
